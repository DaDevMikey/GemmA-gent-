<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kairo.plugin.oneui"
    android:versionCode="1"
    android:versionName="1.0.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="36" />

    <application
        android:allowBackup="true"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:label="Kairo One UI Theme" >
        <service
            android:name="com.kairo.plugin.oneui.OneUiThemePluginService"
            android:exported="true"
            android:label="One UI Design Theme" >
            <intent-filter>
                <action android:name="com.kairo.agent.PLUGIN" />
            </intent-filter>

            <meta-data
                android:name="kairo.plugin.type"
                android:value="theme" />
            <meta-data
                android:name="kairo.plugin.name"
                android:value="One UI Design Theme" />
            <meta-data
                android:name="kairo.plugin.description"
                android:value="Samsung One UI palette &amp; squircle icons (credits: tribalfs/oneui-design &amp; thatjoshguy67/oneui-icons)" />
            <meta-data
                android:name="kairo.plugin.accent_color"
                android:value="#0381FE" />
            <meta-data
                android:name="kairo.plugin.bg_color"
                android:value="#010101" />
            <meta-data
                android:name="kairo.plugin.surface_color"
                android:value="#17171A" />
            <meta-data
                android:name="kairo.plugin.icon_pack"
                android:value="oneui-icons" />
            <meta-data
                android:name="kairo.plugin.corner_dp"
                android:value="22" />
        </service>
    </application>

</manifest>