    <!-- Disclosure dialogs -->
    <string name="disclosure_mic_title">Microphone Access</string>
    <string name="disclosure_mic_body">Used strictly when you tap the mic or enable \'Hey Kairo\' wake word. Audio is processed locally and never uploaded.</string>
    <string name="disclosure_location_title">Location Access</string>
    <string name="disclosure_location_body">Used only when you ask location-based questions (weather, nearby places). Coordinates stay 100%% on-device.</string>
    <string name="disclosure_contacts_title">Contacts Access</string>
    <string name="disclosure_contacts_body">Used locally on-device solely to resolve spoken/typed contact names to phone numbers or emails.</string>
    <string name="disclosure_calling_title">Direct Calling Access</string>
    <string name="disclosure_calling_body">Allows Kairo to place calls directly when you ask instead of stopping at the dialer.</string>
    <string name="disclosure_notif_title">Notification Catch-Up</string>
    <string name="disclosure_notif_body">Reads unread notifications locally in memory so Kairo can summarize what you missed.</string>
    <string name="disclosure_health_title">Health Connect Access</string>
    <string name="disclosure_health_body">Reads your local Health Connect fitness &amp; sleep metrics solely for private on-device summaries.</string>
    <string name="disclosure_brightness_title">Modify System Settings</string>
    <string name="disclosure_brightness_body">Lets Kairo adjust screen brightness directly when you ask.</string>
    <string name="disclosure_onboard_mic_body">Kairo uses your microphone strictly when you tap the mic or enable optional \'Hey Kairo\' wake word detection. Audio is processed locally on your device and never uploaded.</string>
    <string name="disclosure_onboard_assistant_title">Default Digital Assistant</string>
    <string name="disclosure_onboard_assistant_body">Setting Kairo as your Digital Assistant lets it capture transient screen text or screenshots only when you trigger \'Ask about screen\'. Nothing is stored or uploaded.</string>

