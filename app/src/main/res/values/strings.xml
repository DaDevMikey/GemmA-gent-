    <string name="onboarding_voice_title">Core Assistant &amp; Voice</string>
    <string name="onboarding_voice_body">Set up how you talk to Kairo and summon it over any app. Both are optional and run 100%% on-device.</string>
    <string name="onboarding_connections_title">Smart Connections (Optional)</string>
    <string name="onboarding_connections_body">Let Kairo connect with your local apps and data. You can skip any of these and enable them later in Settings.</string>
    <string name="perm_microphone">Microphone</string>
    <string name="perm_microphone_sub">Enables voice prompts, hands-free dictation, and optional \'Hey Kairo\' wake word detection. Audio is transcribed locally and never sent off-device.</string>
    <string name="perm_digital_assistant">Default Digital Assistant</string>
    <string name="perm_digital_assistant_sub">Bind Kairo to your power button or corner swipe to open the floating overlay over any app and ask about your screen.</string>
    <string name="perm_location">Location</string>
    <string name="perm_location_sub">Used locally when you ask for nearby places, local weather, or your current city/address. Coordinates never leave your device.</string>
    <string name="perm_contacts">Contacts</string>
    <string name="perm_contacts_sub">Lets Kairo look up people by name when you say &quot;Call Mom&quot; or &quot;Text Alex on WhatsApp&quot; without needing phone numbers.</string>
    <string name="perm_calling">Direct Calling</string>
    <string name="perm_calling_sub">Allows Kairo to start phone calls immediately when asked, instead of only opening the dialer.</string>
    <string name="perm_notifications">Notification Catch-Up</string>
    <string name="perm_notifications_sub">Reads unread notifications locally (WhatsApp, Telegram, Discord, SMS) so Kairo can summarize what you missed.</string>
    <string name="perm_health">Health Connect</string>
    <string name="perm_health_sub">Reads today\'s steps, heart rate, sleep, distance, calories, and workouts from Health Connect for private on-device wellness summaries.</string>
