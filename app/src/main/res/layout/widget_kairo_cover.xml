<?xml version="1.0" encoding="utf-8"?>
<!-- One UI Home reads the root background ID and its tint alpha for wallpaper blur. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark">
    <LinearLayout
        android:id="@+id/cover_widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/cover_widget_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Kairo"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:id="@+id/cover_widget_ask"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:text="Kairo"
            android:textColor="#E3E3E3"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- RemoteViews needs framework tint; AppCompat app:tint is not applied by hosts. -->
        <ImageButton
            android:id="@+id/cover_widget_mic"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_pill_bg"
            android:contentDescription="Voice"
            android:padding="7dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="#A8C7FA"
            tools:ignore="UseAppTint" />
    </LinearLayout>
</FrameLayout>
